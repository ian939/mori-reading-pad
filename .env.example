# Backend
PORT=8787
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
BOOK_ANALYSIS_BATCH_SIZE=5
MORI_DATA_DIR=./data

# Optional production protections
# When set, MORI_API_TOKEN is required on every request except /api/health
# (registration, listing, detail, and reprocess) via Authorization: Bearer.
# MORI_API_TOKEN=replace-with-a-long-random-token
# ALLOWED_ORIGINS=https://ian939.github.io

# Frontend: leave empty locally because Vite proxies /api.
# Set this to the deployed API origin for GitHub Pages builds.
VITE_API_BASE_URL=
