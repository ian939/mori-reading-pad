{
  "name": "mori-reading-pad",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "verify:touch": "node scripts/verify-touch.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "multer": "^2.3.0",
    "openai": "^7.8.0",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.4",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
